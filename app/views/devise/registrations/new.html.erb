<main class="bg-slate-800 min-h-screen flex flex-col items-center justify-center gap-10 px-4 py-12 text-white">
  <section class="flex flex-col items-center text-center">
    <%= image_tag('chat.png', width: 100, alt: "chat-app") %>
    <h1 class="font-bold text-4xl my-4">Chat App built with Ruby</h1>
    <p class="font-semibold">This is an app created that uses RoR</p>
  </section>
  <section class="flex flex-col items-center w-full max-w-sm">
    <h2 class="font-bold text-2xl mb-5">Sign up</h2>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'flex flex-col gap-4 w-full' }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="flex flex-col gap-1">
        <%= f.label :email, class: 'font-semibold text-sm' %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'rounded w-full px-3 py-2 text-slate-900' %>
      </div>
      <div class="flex flex-col gap-1">
        <%= f.label :password, class: 'font-semibold text-sm' %>
        <%= f.password_field :password, autocomplete: "new-password", class: 'rounded w-full px-3 py-2 text-slate-900',
                             aria: { describedby: ("password_hint" if @minimum_password_length) } %>
        <% if @minimum_password_length %>
          <em id="password_hint" class="text-sm text-slate-300">(<%= @minimum_password_length %> characters minimum)</em>
        <% end %>
      </div>
      <div class="flex flex-col gap-1">
        <%= f.label :password_confirmation, class: 'font-semibold text-sm' %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'rounded w-full px-3 py-2 text-slate-900' %>
      </div>
      <%= f.submit "Sign up", data: { turbo: false }, class: 'bg-green-800 hover:bg-green-700 rounded p-3 mt-2 font-semibold cursor-pointer' %>
    <% end %>
    <div class="flex flex-col w-full mt-4 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </section>
</main>
