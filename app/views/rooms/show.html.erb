<%= turbo_frame_tag 'rooms_controller' do %>
  <%= turbo_stream_from @room %>
  <main class="flex w-full h-screen bg-slate-800">
    <%= render 'shared/sidebar' %>
    <section class="w-full flex flex-col gap-5 h-screen px-5">
      <%= render 'room', room: @room %>
      <div class="flex flex-col gap-3 w-5/6 mx-auto my-5">
        <div class="h-80 bg-white rounded p-2 overflow-y-auto flex flex-col gap-2" id="<%= dom_id(@room, :messages) %>">
          <% @room.messages.order(:created_at).each do |message| %>
            <%= render 'messages/message', { message: message } %>
          <% end %>
        </div>
        <%= render 'messages/form', { room: @room, message: Message.new } %>
      </div>
    </section>
  </main>
<% end %>
