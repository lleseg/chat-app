<%= form_with(model: [room, message], id: 'message-form', class: "w-full flex flex-col") do |form| %>
  <div>
    <%= form.text_field :message, class: "w-full rounded shadow text-sm font-semibold border border-gray-100" %>
    <%= form.submit class: "bg-green-600 text-white font-semibold rounded p-2" %>
  </div>
<% end %>
