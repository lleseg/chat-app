<%= form_with(model: [room, message], id: message.new_record? ? "new_message_form" : dom_id(message, :form), class: "flex w-full gap-2") do |form| %>
  <%= form.text_field :message, placeholder: "Write a message", autocomplete: "off", required: true, "aria-label": "Message", class: "flex-1 rounded border border-gray-300 px-3 py-2 text-sm" %>
  <%= form.submit message.new_record? ? "Send" : "Save", class: "shrink-0 bg-green-600 text-white text-sm font-semibold rounded px-4 py-2 cursor-pointer" %>
<% end %>
