<%= turbo_frame_tag room do %>
  <div class="text-white font-semibold">
    <%= link_to room_path(room), class: 'font-semibold text-white text-sm', data: { turbo_frame: 'rooms_controller' } do %>
      <%= room.name %>
    <% end %>
    <div class="flex items-center gap-3">
      <%= link_to 'Edit', edit_room_path(room), class: 'text-sky-400 text-sm' %>
      <%= button_to 'Delete', room_path(room), method: :delete, form: { data: { turbo_confirm: 'Delete this room?' } }, class: 'text-red-400 text-sm' %>
    </div>
  </div>
<% end %>
